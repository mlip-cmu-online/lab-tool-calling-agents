{
  "name": "MLiP tool-calling agents",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "Airline MCP server",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "Agent web UI",
      "onAutoForward": "openPreview"
    }
  },
  "secrets": {
    "GOOGLE_API_KEY": {
      "description": "Personal Gemini API key used by the Python agent. Do not put it in .env or commit it.",
      "documentationUrl": "https://ai.google.dev/gemini-api/docs/api-key"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    },
    "codespaces": {
      "openFiles": [
        "README.md",
        "python/mcp_airline/src/mcp_airline/tools.py"
      ]
    }
  }
}
